<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.2.0" author="aaltynbek">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM public.product</sqlCheck>
        </preConditions>
        <loadData schemaName="public" tableName="product"
                  file="data/products.csv" relativeToChangelogFile="false"
                  encoding="UTF-8" separator="," quotchar='"'>
            <column name="id" type="NUMERIC"/>
            <column name="created_date" type="DATETIME"/>
            <column name="updated_date" type="DATETIME"/>
            <column name="description" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="spr_column_6" type="SKIP"/>
            <column name="spr_column_7" type="SKIP"/>
            <column name="spr_column_8" type="SKIP"/>
            <column name="spr_column_9" type="SKIP"/>
            <column name="spr_column_10" type="SKIP"/>
            <column name="product_type" type="SKIP"/>
            <column name="segment_type" type="SKIP"/>
            <column name="repayment_type" type="SKIP"/>
            <column name="spr_column_14" type="SKIP"/>
            <column name="spr_column_15" type="SKIP"/>
            <column name="spr_column_16" type="SKIP"/>
            <column name="spr_column_17" type="SKIP"/>
        </loadData>
        <sql>
            SELECT setval('public.product_id_generator', (SELECT COALESCE(max(id), 0) + 1 FROM public.product), false);
        </sql>
        <rollback>
            <sql>DELETE FROM public.product WHERE id BETWEEN 1 AND 8</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.2.1" author="aaltynbek">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM stop_factors.stop_factor</sqlCheck>
        </preConditions>
        <loadData schemaName="stop_factors" tableName="stop_factor"
                  file="data/stop-factor.csv" relativeToChangelogFile="false"
                  encoding="UTF-8" separator="," quotchar='"'>
            <column name="id" type="NUMERIC"/>
            <column name="created_date" type="DATETIME"/>
            <column name="updated_date" type="DATETIME"/>
            <column name="description" type="STRING"/>
            <column name="name" type="STRING"/>
            <column name="is_active" type="BOOLEAN"/>
            <column name="order_number" type="NUMERIC"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM stop_factors.stop_factor WHERE id BETWEEN 1 AND 34</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.2.2" author="aaltynbek">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT count(*) FROM stop_factors.stop_factor_condition</sqlCheck>
        </preConditions>
        <loadData schemaName="stop_factors" tableName="stop_factor_condition"
                  file="data/stop-factor-condition.csv" relativeToChangelogFile="false"
                  encoding="UTF-8" separator="," quotchar='"'>
            <column name="id" type="NUMERIC"/>
            <column name="created_date" type="DATETIME"/>
            <column name="updated_date" type="DATETIME"/>
            <column name="result" type="STRING"/>
            <column name="value" type="STRING"/>
            <column name="value_type" type="STRING"/>
            <column name="stop_factor_id" type="NUMERIC"/>
        </loadData>
        <rollback>
            <sql>DELETE FROM stop_factors.stop_factor_condition WHERE id BETWEEN 2 AND 42</sql>
        </rollback>
    </changeSet>

    <changeSet id="1.2.3" author="aaltynbek">
        <sql>
            SELECT setval('public.stop_factor_id_generator',
                          (SELECT COALESCE(max(id), 0) + 1 FROM stop_factors.stop_factor), false);
            SELECT setval('public.stop_factor_condition_id_generator',
                          (SELECT COALESCE(max(id), 0) + 1 FROM stop_factors.stop_factor_condition), false);
            SELECT setval('public.stop_factor_check_id_generator',
                          (SELECT COALESCE(max(id), 0) + 1 FROM stop_factors.stop_factor_check), false);
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="1.2.4" author="aaltynbek">
        <sql>
            -- One test scoring per product, scoring id = product id; SPR already has these ids
            INSERT INTO public.scoring (id, created_date, product_id)
            SELECT p.id, now(), p.id
            FROM public.product p
            WHERE p.id BETWEEN 1 AND 8
            ON CONFLICT DO NOTHING;
        </sql>
        <rollback>
            <sql>DELETE FROM public.scoring WHERE id BETWEEN 1 AND 8 AND id = product_id</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
