######## Test check (LOCAL ONLY, stop-factor.test-check.enabled=true) ########
# Runs StopFactorService.check with imitated KIB / OB data and saves the results like a real scoring.
# Scorings 1..8 (changelog 1.2, scoring id = product id): 1 Online кредит, 2 Тумар, 4 Тунук онлайн, 6 Онлайн ИФЦ,
# 7 BakAi сплит, 8 Кредитная карта (RETAIL), 3 Онлайн кредит для ИП, 5 Бизнес лимит (MSB)

### Ready scenarios with their expected decisions
GET http://localhost:9090/api/v1/admin/test/stop-factor-check/scenarios

### Run a scenario (asExpected shows whether the decision matches)
POST http://localhost:9090/api/v1/admin/test/stop-factor-check/scenarios/msb-same-history-yellow

### Overdue history: 6 overdue months of 5 days in months 1..3 -> Retail REJECTED (try scoringId 5 = Бизнес лимит -> UNDERWRITER)
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{
  "scoringId": 1,
  "kib": {
    "loans": [ { "role": "MainDebtor", "status": "Open" } ],
    "overdueMonths": [
      { "monthsAgo": 1, "maxOverdueDays": 5 }, { "monthsAgo": 2, "maxOverdueDays": 5 }, { "monthsAgo": 2, "maxOverdueDays": 3 },
      { "monthsAgo": 3, "maxOverdueDays": 7 }, { "monthsAgo": 3, "maxOverdueDays": 10 }, { "monthsAgo": 3, "maxOverdueDays": 1 }
    ]
  }
}

### Raw KIB payment calendars -> KibOverdueHistoryReader finds the months with overdue (as the KIB module)
# One entry per month, as KIB sends it: maxPastDueDays - largest overdue in the month, pastDueDays - left at its end.
# MainDebtor: 4 days in September, 12 in October -> 2 months (OK); 25 days in June -> months 4..6, 21+ days -> REJECTED.
# Guarantor and CoDebtor contracts are not counted.
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{
  "scoringId": -300,
  "productId": 1,
  "requestDate": "2026-11-04",
  "kib": {
    "contracts": [
      { "role": "MainDebtor", "calendar": [
          { "date": "2026-09-30", "maxPastDueDays": 4, "pastDueDays": 4 },
          { "date": "2026-10-31", "maxPastDueDays": 12, "pastDueDays": 0 } ] },
      { "role": "MainDebtor", "calendar": [ { "date": "2026-06-30", "maxPastDueDays": 25, "pastDueDays": 0 } ] },
      { "role": "Guarantor", "calendar": [ { "date": "2026-10-31", "maxPastDueDays": 90, "pastDueDays": 0 } ] },
      { "role": "CoDebtor", "calendar": [ { "date": "2026-10-31", "maxPastDueDays": 40, "pastDueDays": 0 } ] }
    ]
  }
}


### Products: 2 months of 15 days overdue in months 7..12 -> Online кредит REJECTED (try scoringId 5 = Бизнес лимит -> APPROVED)
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "scoringId": 1, "kib": { "overdueMonths": [ { "monthsAgo": 8, "maxOverdueDays": 15 }, { "monthsAgo": 10, "maxOverdueDays": 15 } ] } }

### Any scoring linked to a product: productId writes public.scoring
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "scoringId": -100, "productId": 5, "kib": { "newCreditsLast30Days": 4 } }

### Missing data: no KIB report, only OB (current overdue 5 days -> REJECTED 451)
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "scoringId": 2, "obCredits": [ { "overdueDays": 5, "overdueSum": 1200.50, "lastChangeDate": "2026-10-01" } ] }

### Missing data: partial KIB report (no consolidation) -> the disputes are not checked
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "scoringId": 1, "kib": { "activeDisputes": 2, "missingParts": ["CONSOLIDATION"] } }

### Missing data: SPR could not build the overdue overdue months -> new ranges NO_DATA -> UNDERWRITER
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "scoringId": 1, "kib": { "calendarsUnavailable": true } }

### Missing data: scoring without product -> RETAIL, product limits ignored
POST http://localhost:9090/api/v1/admin/test/stop-factor-check
Content-Type: application/json

{ "kib": {} }

### Saved results of a scoring
GET http://localhost:9090/api/v1/stop-factors/checks/1

######## Admin API ########

### Products (read only, managed by SPR): segmentType is SPR's own, segment the stop factor one (BUSINESS = MSB)
GET http://localhost:9090/api/v1/admin/products

### Calculators: what a metric can be built on, its params, threshold value types and operators
GET http://localhost:9090/api/v1/admin/calculators

######## Metrics ########
# What a stop factor measures and which params it sets. Edited in place.

### Metrics
GET http://localhost:9090/api/v1/admin/metrics

### Create a metric (params left out: every param of the calculator)
POST http://localhost:9090/api/v1/admin/metrics
Content-Type: application/json

{ "title": "Запросы в КИБ за период", "calculator": "BUREAU_REQUESTS_COUNT" }

### Change a metric (title, params, active; refused when a current stop factor would break)
PUT http://localhost:9090/api/v1/admin/metrics/5
Content-Type: application/json

{ "title": "Запросы в кредитное бюро", "calculator": "BUREAU_REQUESTS_COUNT",
  "params": [ { "key": "days", "label": "Последние N дней", "required": true } ] }

######## Stop factor groups ########
# A change of a group or of any of its stop factors creates a new group version with copies of all of them;
# checks keep the version they ran with. Stop factor ids change with every version: take them from the response.

### Current groups with their stop factors (filters: active, productId, segment, metricId)
GET http://localhost:9090/api/v1/admin/stop-factor-groups

### One group / its versions
GET http://localhost:9090/api/v1/admin/stop-factor-groups/5

###
GET http://localhost:9090/api/v1/admin/stop-factor-groups/5/versions

### Create a group with its stop factors
POST http://localhost:9090/api/v1/admin/stop-factor-groups
Content-Type: application/json

{
  "name": "Кредитный комитет",
  "factors": [
    {
      "metricId": 10,
      "name": "Просрочки 30-60 дней за 1-6 месяц",
      "params": { "periodFromMonth": 1, "periodToMonth": 6, "minOverdueDays": 30, "maxOverdueDays": 60 },
      "conditions": [
        { "result": "REJECTED",    "operator": "GT",    "value": "2", "valueType": "INTEGER" },
        { "result": "UNDERWRITER", "operator": "RANGE", "value": "0", "valueTo": "2", "valueType": "INTEGER" }
      ],
      "segment": "RETAIL",
      "productIds": [1, 2]
    }
  ]
}

### Change one stop factor: a new version of its group (factorId from GET)
PUT http://localhost:9090/api/v1/admin/stop-factor-groups/3/stop-factors/36?changeReason=Новый лимит
Content-Type: application/json

{
  "metricId": 8,
  "name": "Общее количество новых открытых кредитов за последние 30 дней",
  "params": { "days": 30 },
  "conditions": [ { "result": "REJECTED", "operator": "GT", "value": "4", "valueType": "INTEGER" } ]
}

### Add / remove a stop factor
DELETE http://localhost:9090/api/v1/admin/stop-factor-groups/3/stop-factors/37?changeReason=Больше не нужен

### Turn a group off / on
PATCH http://localhost:9090/api/v1/admin/stop-factor-groups/4/status?active=false&changeReason=Временно отключена

### Display order: every group id in the new order (in place, no new versions)
PUT http://localhost:9090/api/v1/admin/stop-factor-groups/order
Content-Type: application/json

[1, 2, 3, 4, 5]

### Delete a group (its versions stay for the checks made with them)
DELETE http://localhost:9090/api/v1/admin/stop-factor-groups/4?changeReason=Больше не используется
